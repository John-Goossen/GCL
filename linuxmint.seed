# Language and Locale Settings
d-i debian-installer/locale string en_US.UTF-8
d-i console-setup/ask_detect boolean false
d-i keyboard-configuration/layoutcode string us
d-i keyboard-configuration/modelcode string pc105

# Time Zone Settings
d-i time/zone string America/Chicago
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean true

# Network Configuration
d-i netcfg/get_hostname string unassigned-hostname
d-i netcfg/get_domain string unassigned-domain

# Drive Partitioning (Configured for NVMe Drives)
d-i partman-auto/disk string /dev/nvme0n1
d-i partman-auto/method string regular
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# User Account Creation (Primary User)
d-i passwd/user-fullname string Girl Boss
d-i passwd/username string girlboss
d-i passwd/user-password password G1rlB0ss
d-i passwd/user-password-again password G1rlB0ss
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

# Ubiquity Specific Overrides
ubiquity ubiquity/summary string
ubiquity ubiquity/reboot boolean true
ubiquity user-setup/password-auto-login boolean false
ubiquity ubiquity/use_nonfree boolean true
ubiquity netcfg/get_hostname seen false

# Local USB Post-Installation Script Trigger
ubiquity ubiquity/success_command string \
    string_to_exec() { \
        cp /cdrom/post-install.sh /target/tmp/post-install.sh; \
        chmod +x /target/tmp/post-install.sh; \
        chroot /target /tmp/post-install.sh; \
    }; string_to_exec
